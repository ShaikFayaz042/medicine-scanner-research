!03_ai_classification/*.json
!03_ai_classification/*.txt

04_classified_documents/**/
!04_classified_documents/.gitkeep

05_type_classification/text/
05_type_classification/scanned/
05_type_classification/mixed/
05_type_classification/output/

06_raw_extraction/**/*.txt
06_raw_extraction/**/*.json
06_raw_extraction/**/*.zip

07_raw_extraction_output/**
!07_raw_extraction_output/.gitkeep

08_json_conversion/output/
08_json_conversion/**/*.json
08_json_conversion/**/*.txt

09_normalization/01_staging/**
