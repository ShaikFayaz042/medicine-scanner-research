{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medicine-scanner-api-drw5.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://medicine-scanner-api-drw5.onrender.com/auth/:path*"
    },
    {
      "source": "/scans/:path*",
      "destination": "https://medicine-scanner-api-drw5.onrender.com/scans/:path*"
    },
    {
      "source": "/health",
      "destination": "https://medicine-scanner-api-drw5.onrender.com/health"
    },
    {
      "source": "/static-pdf/:path*",
      "destination": "https://medicine-scanner-api-drw5.onrender.com/static-pdf/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}