
{
  "expo": {
    "name": "MediCheck",
    "slug": "medicheck",
    "owner": "fayaz03c9s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medicheck",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fayaz.medicheck"
    },
    "android": {
      "package": "com.fayaz.medicheck",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-api-cleartext-traffic",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-mlkit-ocr",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MediCheck to use the camera so it can read the barcode and printed label on your medicine pack.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba971dc6-7f67-456a-9ac6-7b224390c2f8"
      }
    }
  }
}
