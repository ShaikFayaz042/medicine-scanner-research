# Set your machine's LAN address for a physical Android device.
#
# NOT localhost: on the phone that means the phone itself. Find your address
# with `ipconfig` (Windows) or `ifconfig | grep inet` (macOS/Linux), and make
# sure the phone is on the same network.
#
# Expo inlines EXPO_PUBLIC_* at BUILD time, and only via a static
# `process.env.EXPO_PUBLIC_API_URL` reference - destructuring or bracket access
# will not work. Restart the dev server after changing this.
EXPO_PUBLIC_API_URL=http://192.168.1.x:8000
# Browser API URL uses the same hostname as the Expo web origin so Lax OAuth
# cookies are sent during the short-lived session handoff.
EXPO_PUBLIC_API_URL_WEB=http://localhost:8000

# Google OAuth client IDs are public values from Google Cloud Console.
# For web, use the same web client ID configured as server GOOGLE_WEB_CLIENT_ID.
# Android native Google Sign-In requires a development build. The Android
# client is registered with the package name and signing SHA-1; the Web client
# ID is passed to native sign-in so the returned ID token matches the backend's
# expected audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
