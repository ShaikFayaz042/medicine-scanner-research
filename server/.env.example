# Application / runtime
PORT=8000
# Use production in deployment to disable the local SQLite fallback.
APP_ENV=development

# Primary ingestion metadata database (set either SCRAPER_DB_URI or the fields below)
SCRAPER_DB_HOST=localhost
SCRAPER_DB_PORT=5432
SCRAPER_DB_NAME=cdsco_monitor
SCRAPER_DB_USER=postgres
SCRAPER_DB_PASSWORD=replace-with-database-password
SCRAPER_DB_URI=postgresql+psycopg2://postgres:replace-with-database-password@db.example.com:5432/cdsco_monitor

# Medicine regulatory database (Supabase/Postgres; mobile tables use this database too)
MEDICINE_DB_HOST=db.<PROJECT_REF>.supabase.co
MEDICINE_DB_PORT=5432
MEDICINE_DB_NAME=postgres
MEDICINE_DB_USER=postgres
MEDICINE_DB_PASSWORD=replace-with-database-password
MEDICINE_DB_URI=postgresql+psycopg2://postgres:replace-with-database-password@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
MEDICINE_DB_SCHEMA=data_schema
MOBILE_DB_SCHEMA=mobile_app_schema

# AWS / S3. Use an IAM task role in deployment instead of storing AWS keys here.
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=replace-with-s3-bucket
AWS_S3_PREFIX=medicine-data-storage

# Pipeline event consumer (SQS)
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<ACCOUNT_ID>/<QUEUE_NAME>
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/<ACCOUNT_ID>/<DLQ_NAME>
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=60
SQS_MAX_RECEIVE_COUNT=3

# Pipeline trigger targets (ECS / Step Functions)
INGESTER_TASK_DEFINITION=replace-with-ingester-task-definition
SFN_STATE_MACHINE_ARN=arn:aws:states:ap-south-1:<ACCOUNT_ID>:stateMachine:<STATE_MACHINE_NAME>
ECS_CLUSTER=replace-with-ecs-cluster-name
ECS_SUBNET=replace-with-subnet-id
ECS_SECURITY_GROUP=replace-with-security-group-id

# ECS / Fargate scheduler. Comma-separate subnet and security-group IDs.
ECS_CLUSTER_NAME=replace-with-ecs-cluster-name
ECS_CLUSTER_ARN=arn:aws:ecs:ap-south-1:<ACCOUNT_ID>:cluster/<CLUSTER_NAME>
ECS_TASK_DEFINITION=replace-with-task-definition-name
ECS_TASK_DEFINITION_ARN=arn:aws:ecs:ap-south-1:<ACCOUNT_ID>:task-definition/<TASK_DEFINITION>:<REVISION>
ECS_SUBNETS=subnet-xxxxxxxx,subnet-yyyyyyyy
ECS_SECURITY_GROUPS=sg-xxxxxxxx
ECS_CONTAINER_NAME=replace-with-container-name
AWS_ACCOUNT_ID=replace-with-aws-account-id

# EventBridge Scheduler
EVENTBRIDGE_SCHEDULE_NAME=cdsco-scraper-daily
EVENTBRIDGE_SCHEDULER_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<SCHEDULER_ROLE>
# Legacy alias; EVENTBRIDGE_SCHEDULER_ROLE_ARN takes precedence.
AWS_SCHEDULER_ROLE_ARN=

# Authentication and mobile API
# Generate unique random values for deployment; never reuse values from this template.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Legacy fallback alias for JWT_SECRET_KEY.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=10080
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_WEB_OAUTH_STATE_SECRET=replace-with-a-different-random-secret-at-least-32-characters
GOOGLE_WEB_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_WEB_APP_CALLBACK_URI=http://localhost:8081/auth/google
GOOGLE_WEB_OAUTH_COOKIE_SAMESITE=lax

# Optional server-side OCR field mapping. Never put this key in the mobile app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15

# HTTP security and rate limits
# Comma-separated browser origins; React Native requests do not use browser CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Comma-separated request hostnames. Replace with the API's deployed hostname(s).
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SCAN=10/minute
