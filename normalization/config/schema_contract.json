{
  "_comment": "Canonical field names, types, nullability, FK relationships, provenance model. Contract between normalizer and DB loader.",
  "version": "0.4.0",
  "schema": "medicine_scanner",

  "document_type_alignment": {
    "aligned_at": "2026-09-13",
    "aligned_with": "type_classification/_index.json",
    "classifier_generated_at": "2026-09-13T13:29:33+00:00",
    "classifier_total_documents": 392,
    "rule": "Any new document_type introduced by the classifier MUST be reflected here and in terminology.json before normalization runs. Normalizer runs in strict mode against document_type_values; unknown values raise an error."
  },

  "document_type_values": [
    "NSQ_ALERT",
    "SPURIOUS_ALERT",
    "DRUG_ALERT",
    "FDC_PROHIBITED",
    "FDC_NOTIFICATION",
    "GAZETTE_LEGAL",
    "PVPI_SAFETY",
    "THEFT_RECALL",
    "MEDICAL_DEVICE",
    "IVD_ALERT",
    "CIRCULAR",
    "GUIDELINE",
    "OTHER"
  ],

  "provenance_model": {
    "primary_provenance_record": "regulatory_events",
    "event_carries": ["source_record_id", "document_id"],
    "entity_tables_role": "canonical identity only; no duplicated raw_data",
    "entity_provenance_table": "entity_sources",
    "entity_provenance_rule": "One canonical entity may merge multiple source records during resolution. entity_sources links entity -> every contributing source_record_id -> regulatory_documents. Normalized JSONL retains source_record_ids[] as rebuildable staging provenance.",
    "audit_trail_location": "normalization/output/*.jsonl",
    "trace_path": "entity -> entity_sources -> regulatory_documents -> source_url/pdf_filename/file_hash",
    "polymorphic_limitation": "entity_sources.(entity_table, entity_id) is polymorphic. PostgreSQL cannot enforce FK to multiple tables. Application-level validation + database/validate.sql required.",
    "source_record_id_validation_rule": "source_record_id format is '<folder>/<filename>.json#<record_index>'. Every source_record_id MUST resolve to an actual record in structured_raw. Validation: normalization/validate_normalized.py."
  },

  "date_precision_rules": {
    "values": ["DAY", "MONTH", "YEAR", "UNKNOWN"],
    "rule": "Never invent day. Store publication_date/mfg_date/expiry_date only when precision == DAY; otherwise NULL and keep raw + precision."
  },

  "document_dedup_rules": {
    "primary_key": ["source_org", "document_id", "document_type"],
    "note_on_cross_folder": "The same PDF can be classified under multiple document_types. These are preserved as separate rows.",
    "note_on_null": "PostgreSQL UNIQUE treats NULLs as distinct; document_id IS NULL rows will NOT dedup via this key.",
    "fallback_chain": [
      ["source_org", "file_hash", "document_type"]
    ],
    "file_hash_source": "PDF SHA-256, never JSON SHA-256",
    "migration_rule": "Before altering unique constraint, run duplicate check and reconcile. Never drop+add blindly."
  },

  "fdc_composition_rule": {
    "rule": "FDC prohibition/restriction/notification compositions are COMBINATION rules, NOT commercial products. They live in regulatory_events with scope=COMBINATION, product_id=NULL, and composition in additional_data.",
    "no_synthetic_products": true,
    "future_extension": "Dedicated fdc_rules/combinations table if combination search becomes a first-class feature."
  },

  "commercial_product_ingredients_rule": {
    "rule": "When a commercial product (NSQ, DRUG_ALERT, SPURIOUS, PVPI) carries a verifiable composition, extract ingredients relationally via product_ingredients -> ingredients.",
    "distinction": "FDC rules -> additional_data only. Commercial products -> relational ingredients."
  },

  "tables": {
    "regulatory_documents": {
      "primary_key": "id",
      "columns": {
        "id": {"type": "BIGSERIAL", "nullable": false},
        "source_org": {"type": "VARCHAR(50)", "nullable": false},
        "source_category": {"type": "VARCHAR(50)", "nullable": false},
        "document_type": {
          "type": "VARCHAR(50)",
          "nullable": false,
          "note": "Must be one of schema_contract.document_type_values.",
          "enum_from": "schema_contract.document_type_values"
        },
        "title": {"type": "TEXT", "nullable": true},
        "publication_date": {"type": "DATE", "nullable": true, "note": "Only set when precision = DAY"},
        "publication_date_raw": {"type": "TEXT", "nullable": true},
        "publication_date_precision": {"type": "VARCHAR(10)", "nullable": true},
        "document_id": {"type": "VARCHAR(100)", "nullable": true},
        "source_url": {"type": "TEXT", "nullable": true},
        "pdf_filename": {"type": "TEXT", "nullable": true},
        "file_hash": {"type": "CHAR(64)", "nullable": true},
        "raw_text": {"type": "TEXT", "nullable": true},
        "extraction_method": {"type": "VARCHAR(30)", "nullable": true},
        "extraction_status": {"type": "VARCHAR(30)", "nullable": true},
        "extraction_confidence": {"type": "NUMERIC(5,2)", "nullable": true},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"}
      },
      "unique": [["source_org", "document_id", "document_type"]],
      "indexes": ["source_org", "document_type", "publication_date", "file_hash"]
    },

    "manufacturers": {
      "primary_key": "id",
      "columns": {
        "id": {"type": "BIGSERIAL", "nullable": false},
        "name": {"type": "TEXT", "nullable": false},
        "normalized_name": {"type": "TEXT", "nullable": false},
        "address": {"type": "TEXT", "nullable": true},
        "country": {"type": "VARCHAR(100)", "nullable": true},
        "match_status": {"type": "VARCHAR(30)", "nullable": false, "default": "UNREVIEWED"},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"}
      },
      "indexes": ["normalized_name"]
    },

    "products": {
      "primary_key": "id",
      "columns": {
        "id": {"type": "BIGSERIAL", "nullable": false},
        "product_name": {"type": "TEXT", "nullable": false},
        "product_name_raw": {"type": "TEXT", "nullable": true},
        "brand_name": {"type": "TEXT", "nullable": true},
        "generic_name": {"type": "TEXT", "nullable": true},
        "dosage_form": {"type": "TEXT", "nullable": true},
        "route": {"type": "TEXT", "nullable": true},
        "manufacturer_id": {"type": "BIGINT", "nullable": true, "fk": "manufacturers.id"},
        "marketer_name": {"type": "TEXT", "nullable": true},
        "importer_name": {"type": "TEXT", "nullable": true},
        "raw_composition": {"type": "TEXT", "nullable": true, "note": "Audit/source only. product_ingredients is structured truth."},
        "normalized_search_name": {"type": "TEXT", "nullable": false},
        "match_status": {"type": "VARCHAR(30)", "nullable": false, "default": "UNREVIEWED"},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"}
      },
      "indexes": ["normalized_search_name", "manufacturer_id"]
    },

    "ingredients": {
      "primary_key": "id",
      "columns": {
        "id": {"type": "BIGSERIAL", "nullable": false},
        "name": {"type": "TEXT", "nullable": false},
        "normalized_name": {"type": "TEXT", "nullable": false},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"}
      },
      "unique": [["normalized_name"]],
      "indexes": ["normalized_name"]
    },

    "product_ingredients": {
      "primary_key": ["product_id", "ingredient_id", "sequence_no"],
      "columns": {
        "product_id": {"type": "BIGINT", "nullable": false, "fk": "products.id"},
        "ingredient_id": {"type": "BIGINT", "nullable": false, "fk": "ingredients.id"},
        "strength": {"type": "NUMERIC(12,4)", "nullable": true},
        "strength_text": {"type": "TEXT", "nullable": true},
        "unit": {"type": "VARCHAR(20)", "nullable": true},
        "basis": {"type": "VARCHAR(40)", "nullable": true},
        "dosage_form": {"type": "TEXT", "nullable": true},
        "sequence_no": {"type": "INT", "nullable": false, "default": 1}
      },
      "indexes": ["product_id", "ingredient_id"]
    },

    "batches": {
      "primary_key": "id",
      "columns": {
        "id": {"type": "BIGSERIAL", "nullable": false},
        "product_id": {"type": "BIGINT", "nullable": false, "fk": "products.id"},
        "manufacturer_id": {"type": "BIGINT", "nullable": true, "fk": "manufacturers.id"},
        "batch_number": {"type": "TEXT", "nullable": false},
        "mfg_date": {"type": "DATE", "nullable": true},
        "mfg_date_raw": {"type": "TEXT", "nullable": true},
        "mfg_date_precision": {"type": "VARCHAR(10)", "nullable": true},
        "expiry_date": {"type": "DATE", "nullable": true},
        "expiry_date_raw": {"type": "TEXT", "nullable": true},
        "expiry_date_precision": {"type": "VARCHAR(10)", "nullable": true},
        "match_status": {"type": "VARCHAR(30)", "nullable": false, "default": "UNREVIEWED"},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"}
      },
      "unique": [["product_id", "manufacturer_id", "batch_number"]],
      "indexes": ["batch_number", "product_id"]
    },

    "regulatory_events": {
      "primary_key": "id",
      "provenance_note": "This is the primary provenance-bearing business record. Entity tables trace back via product_id / batch_id.",
      "columns": {
        "id": {"type": "BIGSERIAL", "nullable": false},
        "document_id": {"type": "BIGINT", "nullable": false, "fk": "regulatory_documents.id"},
        "product_id": {"type": "BIGINT", "nullable": true, "fk": "products.id"},
        "batch_id": {"type": "BIGINT", "nullable": true, "fk": "batches.id"},
        "scope": {"type": "VARCHAR(30)", "nullable": false},
        "event_type": {"type": "VARCHAR(50)", "nullable": false},
        "status": {"type": "VARCHAR(50)", "nullable": true, "note": "NULL allowed for pure document-classification events (circular/guideline/notification)."},
        "legal_status": {"type": "VARCHAR(50)", "nullable": true},
        "reason": {"type": "TEXT", "nullable": true},
        "effective_date": {"type": "DATE", "nullable": true},
        "investigation_status": {"type": "VARCHAR(50)", "nullable": true},
        "sample_collected_by": {"type": "TEXT", "nullable": true},
        "testing_lab": {"type": "TEXT", "nullable": true},
        "legal_reference": {"type": "TEXT", "nullable": true},
        "additional_data": {
          "type": "JSONB",
          "nullable": true,
          "known_shapes": {
            "prose_record": {
              "raw_text": "string",
              "detected": "object|null",
              "review_required": "boolean",
              "extraction_status": "PROSE_ONLY|EMPTY"
            },
            "table_record": {
              "raw_data": "object",
              "canonical": "object",
              "record_type": "string"
            }
          }
        },
        "source_record_id": {"type": "TEXT", "nullable": false},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"}
      },
      "indexes": ["document_id", "product_id", "batch_id", "event_type", "status", "legal_status"]
    },

    "entity_sources": {
      "primary_key": "id",
      "role": "provenance infrastructure (NOT a business entity)",
      "columns": {
        "id": {"type": "BIGSERIAL", "nullable": false},
        "entity_table": {"type": "VARCHAR(50)", "nullable": false, "allowed_values": ["products", "manufacturers", "batches", "ingredients"]},
        "entity_id": {"type": "BIGINT", "nullable": false},
        "source_record_id": {"type": "TEXT", "nullable": false},
        "document_id": {"type": "BIGINT", "nullable": false, "fk": "regulatory_documents.id"},
        "created_at": {"type": "TIMESTAMPTZ", "nullable": false, "default": "now()"}
      },
      "unique": [["entity_table", "entity_id", "source_record_id"]],
      "indexes": ["(entity_table, entity_id)", "document_id", "source_record_id"],
      "constraints": [
        "entity_table IN ('products','manufacturers','batches','ingredients')"
      ],
      "polymorphic_limitation": "FK to entity tables cannot be enforced by PostgreSQL. Enforce via database/validate.sql."
    }
  },

  "nullability_rules": {
    "regulatory_events.document_id": "NOT NULL",
    "regulatory_events.product_id": "NULL allowed (combination/industry scope)",
    "regulatory_events.batch_id": "NULL allowed (non-batch scope)",
    "regulatory_events.status": "NULL allowed for document-only events",
    "batches.product_id": "NOT NULL",
    "product_ingredients.product_id": "NOT NULL",
    "product_ingredients.ingredient_id": "NOT NULL",
    "entity_sources.entity_id": "NOT NULL (validated by application, not FK)"
  }
}