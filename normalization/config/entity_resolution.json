{
  "_comment": "Initial engineering thresholds, NOT final truth. Tune after evaluating 50-100 real matches. Manufacturer fuzzy matches NEVER auto-merge without additional evidence.",
  "version": "0.3.0",
  "method": "rapidfuzz",
  "thresholds": {
    "product": {
      "auto_name_sim": 0.92,
      "auto_min_intra_cluster": 0.88,
      "review_name_sim": 0.85,
      "require_same_manufacturer_for_auto": true
    },
    "manufacturer": {
      "auto_allowed": false,
      "review_name_sim": 0.85
    },
    "ingredient": {
      "auto_requires_exact_normalized_match": true,
      "review_name_sim": 0.88,
      "auto_min_intra_cluster": 0.90
    }
  },
  "entities": {
    "document": {
      "match_keys": [["source_org", "document_id"]],
      "fallback_chain": [["file_hash"], ["source_org", "pdf_filename"]],
      "actions": {"high_confidence": "AUTO_MERGE", "medium_confidence": "REVIEW", "low_confidence": "DO_NOT_MERGE"},
      "note": "NULL document_id bypasses primary key; loader falls back per schema_contract.document_dedup_rules."
    },
    "ingredient": {
      "match_keys": [["normalized_name"]],
      "actions": {"high_confidence": "AUTO_MERGE", "medium_confidence": "REVIEW", "low_confidence": "DO_NOT_MERGE"}
    },
    "batch": {
      "match_keys": [["product_id", "manufacturer_id", "batch_number"]],
      "actions": {"high_confidence": "AUTO_MERGE", "medium_confidence": "REVIEW", "low_confidence": "DO_NOT_MERGE"},
      "note": "Exact (product_id, manufacturer_id, batch_number) is authoritative; fuzzy only for batch_number typos within same product."
    },
    "product": {
      "match_keys": [["normalized_search_name", "manufacturer_id", "dosage_form"]],
      "actions": {"high_confidence": "AUTO_MERGE", "medium_confidence": "REVIEW", "low_confidence": "DO_NOT_MERGE"}
    },
    "manufacturer": {
      "match_keys": [["normalized_name", "country"]],
      "actions": {
        "high_confidence": "REVIEW",
        "medium_confidence": "REVIEW",
        "low_confidence": "DO_NOT_MERGE"
      },
      "note": "Manufacturers are legal entities. Name similarity alone is NEVER sufficient to auto-merge, regardless of score. Additional evidence required (same address, same country + same license, or explicit source statement)."
    }
  },
  "output": {
    "review_file": "normalization/output/entity_review.jsonl",
    "auto_merge_log": "normalization/output/entity_auto_merge.jsonl"
  },
  "review_record_fields": [
    "entity_type",
    "raw_value",
    "normalized_value",
    "candidate_entity_id",
    "candidate_entity_value",
    "similarity_score",
    "action",
    "reason",
    "source_record_id",
    "source_document_id"
  ]
}