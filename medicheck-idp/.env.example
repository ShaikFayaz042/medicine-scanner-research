# ---- Stage 5: classifier (config/settings.py) ----
# Rule files; defaults to medicheck-idp/rules
IDP_RULES_DIR=
# LLM fallback for units the rules cannot settle: none | bedrock | gemini | package.module:ClassName
# With "none", those units are written with status needs_review.
IDP_LLM_PROVIDER=none
# Model or inference-profile ID, e.g. in.anthropic.claude-haiku-4-5-20251001-v1:0 (Bedrock, India profile)
IDP_LLM_MODEL=
# Bedrock region; falls back to AWS_REGION
IDP_LLM_REGION=ap-south-1
# Ask the provider to enforce the reply schema (falls back to prompt-and-parse when unsupported)
IDP_LLM_STRUCTURED_OUTPUT=true
IDP_LLM_TIMEOUT_SECONDS=120
# Directory for cached LLM answers (re-runs reuse them)
IDP_LLM_CACHE_DIR=
# Only for IDP_LLM_PROVIDER=gemini
GEMINI_API_KEY=
